# Auth and default Content mode. Allowed mode values: real, mock.
VITE_API_MODE=real
VITE_API_URL=https://sketch-tale-be.onrender.com/api
VITE_CONTENT_API_MODE=real

# Core areas remain mock; individual modules override these values.
VITE_PARENT_API_MODE=mock
VITE_ADMIN_API_MODE=mock

# Explicit values make the hybrid setup visible (see docs/ARCHITECTURE.md).
VITE_PARENT_PROFILE_API_MODE=real
VITE_PARENT_CATALOG_API_MODE=mock
VITE_PARENT_SUBSCRIPTION_API_MODE=real
# Keep live checkout disabled until webhook entitlement updates and payment status lookup are ready.
VITE_PARENT_PAYMENT_API_MODE=mock
# Requires Parent profile mode real so the inbox receives a backend ChildProfile ID.
VITE_PARENT_APPROVALS_API_MODE=mock
VITE_ADMIN_CATALOG_API_MODE=real
VITE_ADMIN_REPORTS_API_MODE=real
VITE_ADMIN_MODERATION_CATALOG_API_MODE=real
