VITE_API_MODE=real
VITE_API_URL=https://sketch-tale-be.onrender.com/api
VITE_CONTENT_API_MODE=real

# Admin and Parent still use local mocks in development by default.
# Enable an individual live API only after its backend endpoints are available:
# VITE_ADMIN_API_MODE=real
# VITE_PARENT_API_MODE=real

# Optional API areas; Parent profile defaults to real when VITE_API_MODE=real.
# VITE_PARENT_PROFILE_API_MODE=real
# Set to real to load published stories and education-theme labels in Parent Library.
# VITE_PARENT_CATALOG_API_MODE=real
# VITE_PARENT_SUBSCRIPTION_API_MODE=mock
# VITE_ADMIN_REPORTS_API_MODE=mock # default is real for read-only list/detail
# VITE_ADMIN_MODERATION_CATALOG_API_MODE=real
